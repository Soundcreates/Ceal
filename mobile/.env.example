# ============================================================
# AfterMath Mobile — Environment Variables
# ============================================================
# This checked-in file provides safe defaults for local builds.
# If you need private values, create your own local .env and mirror the keys.
#
# Loaded at runtime via flutter_dotenv:
#   await dotenv.load(fileName: ".env.example");
#   final url = dotenv.env['API_BASE_URL']!;
# ============================================================

# ------------------------------------------------------------
# Backend API
# ------------------------------------------------------------

# Base URL of the AfterMath REST API (no trailing slash).
# Default hardcoded fallback: https://api.aftermath.local/v1
API_BASE_URL=

# Bearer token used to authenticate mobile → backend requests.
# In production, obtain this via Firebase Auth ID token exchange.
API_AUTH_TOKEN=

# User UUID used by Aadhaar QR onboarding verification endpoint.
# Optional, but required if you don't provide userId in-app.
ONBOARDING_USER_ID=

# ------------------------------------------------------------
# BLE Encryption
# ------------------------------------------------------------

# Shared BLE secret. Leave blank to use the compiled fallback in non-prod builds.
BLE_ENCRYPTION_SECRET=

# ------------------------------------------------------------
# Feature Flags (optional — omit to use compiled defaults)
# ------------------------------------------------------------

# Number of seconds user has to cancel an SOS before it fires.
# SOS_CANCEL_COUNTDOWN_SEC=5

# Seconds after broadcast with no ACK before SMS fallback triggers.
# SMS_FALLBACK_TIMEOUT_SEC=30

# Maximum mesh relay hops (TTL).
# BLE_DEFAULT_TTL=5
