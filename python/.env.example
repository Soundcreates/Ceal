# ============================================================
# CEAL Python QR Service — Environment Variables
# ============================================================
# Copy this file to .env (or set in your deploy platform) and fill in values.
# NEVER commit real secrets.

# ------------------------------------------------------------
# TS Backend target
# ------------------------------------------------------------

# Option A (recommended): set a base URL + path
# - Base URL of the TS backend (no trailing slash)
# - Path of the endpoint to forward decoded Aadhaar XML to
TS_BACKEND_BASE_URL=
TS_BACKEND_PATH=/v1/onboarding/verify-aadhaar-qr

# Option B: set a full URL (overrides BASE_URL + PATH)
# TS_BACKEND_URL=

# Optional: bearer token if your backend endpoint is protected
TS_BACKEND_AUTH_TOKEN=

# ------------------------------------------------------------
# Python service
# ------------------------------------------------------------

# Optional shared secret header (sent as x-python-service-secret).
# Only useful if your TS backend validates it.
PYTHON_SERVICE_SECRET=

# HTTP timeout for forwarding requests to the TS backend
PYTHON_REQUEST_TIMEOUT_SEC=20
