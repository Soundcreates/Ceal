/**
 * CEAL Backend — PostgreSQL connection pool.
 */

import pg from 'pg';
import { env } from '../config.js';
import { logger } from '../logger.js';

const { Pool } = pg;

const dbUrl = new URL(env.DATABASE_URL);
const sslMode = dbUrl.searchParams.get('sslmode')?.toLowerCase();
const useSsl =
  sslMode === 'require' ||
  sslMode === 'verify-ca' ||
  sslMode === 'verify-full';

export const pool = new Pool({
  connectionString: env.DATABASE_URL,
  ssl: useSsl ? { rejectUnauthorized: false } : false,
  max: 20,
  idleTimeoutMillis: 30_000,
  connectionTimeoutMillis: 30_000,  // allow Neon cold-start (can take ~10-20s)
  keepAlive: true,
  keepAliveInitialDelayMillis: 10_000,  // send TCP keep-alive after 10s idle
});

/**
 * Execute a pool query with one automatic retry on transient connection errors
 * (e.g. Neon cold-start killing an idle connection mid-flight).
 */
export async function queryWithRetry<T extends pg.QueryResultRow = any>(
  text: string,
  params?: unknown[],
): Promise<pg.QueryResult<T>> {
  try {
    return await pool.query<T>(text, params);
  } catch (err: any) {
    const isTransient =
      err?.message?.includes('Connection terminated') ||
      err?.message?.includes('connection timeout') ||
      err?.code === 'ECONNRESET' ||
      err?.code === '57P01'; // admin shutdown
    if (isTransient) {
      logger.warn('Transient DB error, retrying once…', { message: err.message });
      return pool.query<T>(text, params);
    }
    throw err;
  }
}

pool.on('error', (err) => {
  logger.error('Unexpected PG pool error', err);
});

/**
 * Gracefully shut down the pool (called on SIGTERM).
 */
export async function closePool(): Promise<void> {
  await pool.end();
  logger.info('PG pool closed');
}
