# ============================================================
# AfterMath Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
#
# Usage (Node.js):
#   import 'dotenv/config';        // ESM
#   require('dotenv').config();    // CJS
# ============================================================

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Allowed CORS origin(s) for the responder dashboard.
# Comma-separated for multiple origins.
CORS_ORIGIN=http://localhost:3001

# ------------------------------------------------------------
# BLE Encryption
# ------------------------------------------------------------

# Shared HMAC + XOR secret. Must match the .env in the mobile app.
# Generate with: openssl rand -hex 32
BLE_ENCRYPTION_SECRET=aftermath-dev-secret-replace-me

# ------------------------------------------------------------
# Firebase (Auth + Firestore)
# ------------------------------------------------------------

# Firebase project ID (found in Firebase Console → Project Settings).
FIREBASE_PROJECT_ID=your-firebase-project-id

# Path to the service account JSON key downloaded from Firebase Console.
# OR set GOOGLE_APPLICATION_CREDENTIALS to the same path and omit this.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# Alternatively, paste the raw JSON as a single-line string:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ------------------------------------------------------------
# Database (PostgreSQL via Neon)
# ------------------------------------------------------------

# Full connection string (pooled recommended for serverless).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# ------------------------------------------------------------
# Twilio (SMS / Voice escalation fallback)
# ------------------------------------------------------------

# Account credentials (Master credentials — prefer API Key below for production).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Twilio API Key (scoped credentials — preferred over Auth Token in production).
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret

# Phone number to send SMS from (must be a Twilio number).
TWILIO_FROM_NUMBER=+15550000000

# Phone number to forward unacknowledged SOS alerts to (e.g. dispatch centre).
TWILIO_ESCALATION_NUMBER=+15559999999

# ------------------------------------------------------------
# JWT / API Token (optional — used if not using Firebase Auth)
# ------------------------------------------------------------

# Secret used to sign/verify JWTs issued to responder dashboard users.
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-replace-me

# Token expiry duration (ms or zeit/ms string): 1h, 24h, 7d
JWT_EXPIRES_IN=1h

# ------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------

# Max SOS ingest requests per IP per window.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

# Log level: error | warn | info | http | debug
LOG_LEVEL=info
