# ============================================================
# AfterMath Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
#
# Usage (Node.js):
#   import 'dotenv/config';        // ESM
#   require('dotenv').config();    // CJS
# ============================================================

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Allowed CORS origin(s) for the responder dashboard.
# Comma-separated for multiple origins.
CORS_ORIGIN=http://localhost:5173,http://localhost:3001,https://ceal-peach.vercel.app

# ------------------------------------------------------------
# BLE Encryption
# ------------------------------------------------------------

# Shared BLE secret. Must match the .env in the mobile app.
# Generate with: openssl rand -hex 32
BLE_ENCRYPTION_SECRET=aftermath-dev-secret-replace-me

# Secret used to gate /v1/auth/token and derive server-side hashes.
# Generate with: openssl rand -hex 32
SERVER_SECRET=server-secret-change-me

# ------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------

# Full connection string (pooled recommended for serverless).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# ------------------------------------------------------------
# Twilio (optional escalation SMS)
# ------------------------------------------------------------

# Account credentials (optional if you use API Key auth below).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Twilio API Key (preferred over Auth Token in production).
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret

# Phone number to send SMS from (must be a Twilio number).
TWILIO_FROM_NUMBER=+15550000000

# Phone number to forward unacknowledged SOS alerts to (e.g. dispatch centre).
TWILIO_ESCALATION_NUMBER=+15559999999

# ------------------------------------------------------------
# JWT / API Token
# ------------------------------------------------------------

# Secret used to sign/verify JWTs issued to responder dashboard users.
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-replace-me

# Token expiry duration (ms or zeit/ms string): 1h, 24h, 7d
JWT_EXPIRES_IN=1h

# ------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------

# Max non-SOS requests per IP per window.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Disaster reports allowed per user in the last hour.
DISASTER_REPORT_RATE_LIMIT=5

# Max uploaded disaster image size in bytes (5 MiB default).
DISASTER_IMAGE_MAX_BYTES=5242880

# Use test Anon Aadhaar keys in non-production environments.
USE_TEST_AADHAAR=false

# Optional Gemini key for disaster image verification.
GEMINI_API_KEY=

# Optional Cloudinary credentials for image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

# Log level: error | warn | info | http | debug
LOG_LEVEL=info
